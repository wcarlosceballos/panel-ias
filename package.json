{
  "name": "panel-ias-generativas",
  "productName": "Panel de IAs",
  "version": "1.0.0",
  "description": "Menu lateral con tus herramientas de IA en una sola ventana",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.panel.ias",
    "productName": "Panel de IAs",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
